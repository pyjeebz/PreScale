{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pyjeebz/prescale/result.schema.json",
  "title": "PreScale Result",
  "description": "The versioned envelope produced by `prescale run` and stored under .prescale/runs/ (schema_version 1). Additive fields may appear without bumping the version, so consumers should ignore unknown properties.",
  "type": "object",
  "required": [
    "schema_version", "kind", "id", "tool_version", "created_at",
    "target", "config", "verdict", "stages"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "enum": ["run", "audit"] },
    "id": { "type": "string", "description": "Filename stem; sorts chronologically." },
    "tool_version": { "type": "string" },
    "created_at": { "type": "string", "description": "UTC ISO-8601, e.g. 2026-06-28T17:36:48Z." },
    "warning": { "type": ["string", "null"] },
    "target": {
      "type": "object",
      "required": ["url", "host", "routes"],
      "properties": {
        "url": { "type": "string" },
        "host": { "type": "string" },
        "routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "method", "max_users", "stage_seconds",
        "latency_wall_s", "error_threshold", "max_rps"
      ],
      "properties": {
        "method": { "type": "string" },
        "max_users": { "type": "integer" },
        "stage_seconds": { "type": "number" },
        "latency_wall_s": { "type": "number" },
        "error_threshold": { "type": "number" },
        "max_rps": { "type": ["number", "null"] },
        "warmup": { "type": "boolean" },
        "repeat": { "type": "integer" },
        "think_time_s": { "type": "number" },
        "fail_under": { "type": ["integer", "null"] },
        "profile": { "type": ["string", "null"] },
        "replica": {
          "type": "boolean",
          "description": "True when PreScale started the app's own build locally (--app) and tested that, not a deployed host."
        },
        "mode": {
          "type": "string",
          "enum": ["journeys"],
          "description": "\"journeys\" when the run replayed journeys (prescale/journeys/); absent for a URL run."
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "survives_users", "max_tested", "onset_users", "onset_reason",
        "culprit_route", "bottleneck", "saturated", "saturation_users",
        "peak_rps", "marginal"
      ],
      "properties": {
        "survives_users": { "type": "integer" },
        "max_tested": { "type": "integer" },
        "onset_users": { "type": ["integer", "null"] },
        "onset_reason": { "type": ["string", "null"], "enum": ["errors", "latency", null] },
        "culprit_route": { "type": ["string", "null"] },
        "culprit_journey": {
          "type": ["string", "null"],
          "description": "Journey runs: the journey that breaks first. The verdict, stages and culprit_route (a step's method and path) are that journey's."
        },
        "bottleneck": { "type": ["string", "null"] },
        "saturated": { "type": "boolean" },
        "saturation_users": { "type": ["integer", "null"] },
        "peak_rps": { "type": "number" },
        "marginal": { "type": "boolean" },
        "confidence": {
          "type": "object",
          "properties": {
            "survives_low": { "type": ["integer", "null"] },
            "survives_high": { "type": ["integer", "null"] },
            "stable": { "type": "boolean" }
          }
        }
      }
    },
    "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
    "environment": {
      "type": "object",
      "properties": {
        "git_commit": { "type": ["string", "null"] },
        "git_branch": { "type": ["string", "null"] }
      }
    },
    "journeys": {
      "type": "array",
      "description": "Present on journey runs: one entry per journey. Each journey that replays is ramped on its own; a stale or unreachable one isn't load-tested and carries the reason.",
      "items": { "$ref": "#/$defs/journey" }
    },
    "investigation": {
      "type": "object",
      "description": "Present when `prescale investigate` diagnosed a failure.",
      "properties": {
        "culprit_route": { "type": "string" },
        "bottleneck_class": { "type": "string" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "summary": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "remediation": { "type": "array", "items": { "type": "string" } },
        "stack": { "type": "object" }
      }
    },
    "profile": {
      "type": "object",
      "description": "Present when `run --profile` or `investigate --profile` framed the run as a launch scenario.",
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "peak_users": { "type": "integer" },
        "would_survive": { "type": "boolean" }
      }
    },
    "audit": {
      "type": "array",
      "description": "Present when the run included the load-free HTTP hygiene audit (`investigate --audit`).",
      "items": {
        "type": "object",
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail", "info"] },
          "detail": { "type": "string" },
          "fix": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "journey": {
      "type": "object",
      "required": ["name", "type", "weight", "status", "reason"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "weight": { "type": "number" },
        "status": { "enum": ["ok", "stale", "unreachable"] },
        "reason": { "type": ["string", "null"], "description": "Why a stale or unreachable journey wasn't load-tested." },
        "survives_users": { "type": "integer" },
        "max_tested": { "type": "integer" },
        "onset_users": { "type": ["integer", "null"] },
        "onset_reason": { "type": ["string", "null"], "enum": ["errors", "latency", null] },
        "confidence": {
          "type": "object",
          "properties": {
            "survives_low": { "type": ["integer", "null"] },
            "survives_high": { "type": ["integer", "null"] },
            "stable": { "type": "boolean" }
          }
        },
        "culprit_step": {
          "type": ["object", "null"],
          "properties": {
            "index": { "type": "integer", "description": "1-based step number." },
            "name": { "type": "string" },
            "route": { "type": "string" }
          }
        },
        "bottleneck": { "type": ["string", "null"] },
        "steps_at_users": { "type": ["integer", "null"], "description": "The level the step timings come from: where it broke, else the highest tested." },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "name", "route", "requests"],
            "properties": {
              "index": { "type": "integer" },
              "name": { "type": "string" },
              "route": { "type": "string" },
              "requests": { "type": "integer" },
              "p50_ms": { "type": ["integer", "null"] },
              "p95_ms": { "type": ["integer", "null"] },
              "error_rate": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "users", "rps", "p50_ms", "p95_ms", "p99_ms",
        "error_rate", "errors", "total", "routes"
      ],
      "properties": {
        "users": { "type": "integer" },
        "rps": { "type": "number" },
        "p50_ms": { "type": "integer" },
        "p95_ms": { "type": "integer" },
        "p99_ms": { "type": "integer" },
        "error_rate": { "type": "number" },
        "errors": { "type": "integer" },
        "total": { "type": "integer" },
        "samples": { "type": "integer" },
        "routes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/route" } }
      }
    },
    "route": {
      "type": "object",
      "required": ["total", "errors", "error_rate", "rps", "p50_ms", "p95_ms", "p99_ms"],
      "properties": {
        "total": { "type": "integer" },
        "errors": { "type": "integer" },
        "error_rate": { "type": "number" },
        "rps": { "type": "number" },
        "p50_ms": { "type": "integer" },
        "p95_ms": { "type": "integer" },
        "p99_ms": { "type": "integer" }
      }
    }
  }
}

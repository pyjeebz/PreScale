{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/install",
      "headers": [
        { "key": "Content-Type", "value": "text/x-shellscript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/install.ps1",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "https://prescale-dashboard.vercel.app/dashboard" },
    { "source": "/dashboard/:path*", "destination": "https://prescale-dashboard.vercel.app/dashboard/:path*" },
    { "source": "/r/:path*", "destination": "https://prescale-dashboard.vercel.app/dashboard/r/:path*" },
    { "source": "/s/:path*", "destination": "https://prescale-dashboard.vercel.app/dashboard/s/:path*" },
    { "source": "/badge/:path*", "destination": "https://prescale-dashboard.vercel.app/dashboard/badge/:path*" },
    { "source": "/b/:path*", "destination": "https://prescale-dashboard.vercel.app/dashboard/b/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
